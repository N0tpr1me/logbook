  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.0",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "wheel-gestures": "2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
